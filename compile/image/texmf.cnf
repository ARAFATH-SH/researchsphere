% Site settings of the compile sandbox (docs/compile.md), read before TeX Live's own texmf.cnf.
% Paranoid writing: no file is written by an absolute path or into a parent folder, so
% \openout to /tmp/x or ../x is refused. Shell escape is off entirely.
% openin_any = p is set too, but pdfTeX in TeX Live 2026 does not restrict \input, \openin or
% \IfFileExists by it (make test-compile-sandbox measures this): reads are contained by the
% container instead, which holds only the image's public files and this project's files.
openin_any = p
openout_any = p
shell_escape = f
% Unwrapped log lines, so the parser reads each error and file name whole (FR-13.2).
max_print_line = 10000
error_line = 254
half_error_line = 238
