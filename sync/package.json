{
  "name": "researchsphere-sync",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time editing server (slice 22): Hocuspocus and Yjs, reaching the database only through the API's internal operations.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/main.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "load": "node scripts/load.ts"
  },
  "dependencies": {
    "@hocuspocus/server": "4.8.0",
    "ioredis": "6.0.0",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hocuspocus/provider": "4.8.0",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
