# Copy this file to .env and adjust it:  cp .env.example .env
# .env is ignored by git. Never commit real passwords or API keys.
# Whenever the code needs a new setting, add it here with a safe example value.

# PostgreSQL (the local Docker container)
POSTGRES_USER=researchsphere
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=researchsphere
POSTGRES_PORT=5433
DATABASE_URL=postgres://researchsphere:devpassword@localhost:5433/researchsphere?sslmode=disable

# Redis (the local Docker container)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Object storage (FR-4.6, NFR-13): MinIO in docker-compose.yml, S3-compatible. The bucket is
# private; files are read only through short-lived presigned URLs. S3_ENDPOINT is host:port
# without a scheme; S3_USE_SSL chooses https. These keys are also MinIO's root user locally:
# use a key limited to the bucket everywhere else.
S3_ENDPOINT=localhost:9000
S3_REGION=us-east-1
S3_BUCKET=researchsphere
S3_ACCESS_KEY=researchsphere
S3_SECRET_KEY=local-dev-only-minio-secret
S3_USE_SSL=false
MINIO_API_PORT=9000
# Web console at http://localhost:9001 (log in with S3_ACCESS_KEY and S3_SECRET_KEY).
MINIO_CONSOLE_PORT=9001

# API server (backend/cmd/api). DATABASE_URL, REDIS_URL and the S3_ settings above are required.
API_PORT=8080
# One of debug, info, warn, error.
LOG_LEVEL=info

# Email (FR-1.3). The defaults send to Mailpit from docker-compose.yml, which keeps every
# message in a web inbox at http://localhost:8025 and delivers nothing.
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# A bare address: CI and the Makefile read this file as shell and make syntax, where
# "Name <address>" breaks. When MAIL_FROM is unset, the sender is
# "ResearchSphere <no-reply@researchsphere.local>".
MAIL_FROM=no-reply@researchsphere.local
# Where the web client runs. Verification links in emails point to this address.
APP_BASE_URL=http://localhost:3000

# Login (FR-2.1). Signs the 15-minute access tokens (HS256); at least 32 bytes. This value
# is for local work only: use a fresh one everywhere else, made with  openssl rand -base64 48
# Session cookies get the Secure flag when APP_BASE_URL starts with https://.
JWT_SECRET=local-dev-only-jwt-secret-change-me-0123456789

# Publication metadata by DOI (FR-5.2). OPENALEX_BASE_URL defaults to https://api.openalex.org;
# tests point it at a fake server. OPENALEX_MAILTO is optional: a contact address sent with
# each request, which puts the API server in OpenAlex's faster "polite pool". Use a team
# address, not a personal one.
OPENALEX_BASE_URL=https://api.openalex.org
OPENALEX_MAILTO=

# Web client (frontend/). The Next.js server forwards /api/v1 to this address, so the
# browser makes no cross-origin requests. Server-side only: never prefix it with NEXT_PUBLIC_.
API_URL=http://localhost:8080
