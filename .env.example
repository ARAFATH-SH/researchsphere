# Copy this file to .env and adjust it:  cp .env.example .env
# .env is ignored by git. Never commit real passwords or API keys.
# Whenever the code needs a new setting, add it here with a safe example value.

# PostgreSQL (the local Docker container)
POSTGRES_USER=researchsphere
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=researchsphere
POSTGRES_PORT=5433
DATABASE_URL=postgres://researchsphere:devpassword@localhost:5433/researchsphere?sslmode=disable

# Redis (the local Docker container)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Tests (make test-db, make test-integration) never use the database and Redis DB above.
# make test-prepare creates TEST_POSTGRES_DB in the same container and migrates it. The
# tests empty both before every test, so they refuse a database whose name does not end
# in _test and Redis DB 0 (or the DB REDIS_URL uses).
TEST_POSTGRES_DB=researchsphere_test
TEST_DATABASE_URL=postgres://researchsphere:devpassword@localhost:5433/researchsphere_test?sslmode=disable
TEST_REDIS_URL=redis://localhost:6379/15

# Object storage (FR-4.6, NFR-13): MinIO in docker-compose.yml, S3-compatible. The bucket is
# private; files are read only through short-lived presigned URLs. S3_ENDPOINT is host:port
# without a scheme; S3_USE_SSL chooses https. These keys are also MinIO's root user locally:
# use a key limited to the bucket everywhere else. Browsers reach this address too (presigned
# downloads and figure uploads): outside production "localhost" and ::1 are used as 127.0.0.1,
# where docker-compose.yml publishes MinIO, as a browser may try "localhost" over IPv6 first.
S3_ENDPOINT=127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=researchsphere
S3_ACCESS_KEY=researchsphere
S3_SECRET_KEY=local-dev-only-minio-secret
S3_USE_SSL=false
MINIO_API_PORT=9000
# Web console at http://localhost:9001 (log in with S3_ACCESS_KEY and S3_SECRET_KEY).
MINIO_CONSOLE_PORT=9001

# API server (backend/cmd/api). DATABASE_URL, REDIS_URL and the S3_ settings above are required.
API_PORT=8080
# One of debug, info, warn, error.
LOG_LEVEL=info

# Email (FR-1.3). The defaults send to Mailpit from docker-compose.yml, which keeps every
# message in a web inbox at http://localhost:8025 and delivers nothing.
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# A bare address: CI and the Makefile read this file as shell and make syntax, where
# "Name <address>" breaks. When MAIL_FROM is unset, the sender is
# "ResearchSphere <no-reply@researchsphere.local>".
MAIL_FROM=no-reply@researchsphere.local
# FR-17.1: the provider is chosen by these settings alone (docs/email-delivery.md).
# SMTP_TLS is starttls (port 587), tls (port 465) or none (Mailpit only). SMTP_USERNAME and
# SMTP_PASSWORD log in; set both or neither. With APP_ENV=production the API refuses to start
# when SMTP_TLS is none, SMTP_HOST is this machine, or the username or password is missing.
SMTP_TLS=none
SMTP_USERNAME=
SMTP_PASSWORD=
# Where the web client runs. Verification links in emails point to this address.
APP_BASE_URL=http://localhost:3000

# Login (FR-2.1). Signs the 15-minute access tokens (HS256); at least 32 bytes. This value
# is for local work only: use a fresh one everywhere else, made with  openssl rand -base64 48
# Session cookies get the Secure flag when APP_BASE_URL starts with https://.
JWT_SECRET=local-dev-only-jwt-secret-change-me-0123456789

# Unread message digest (FR-16.11). Signs the unsubscribe links in the digest emails; at least
# 32 bytes and different from JWT_SECRET. The links never expire, so changing it breaks every
# link already sent. Local work only: elsewhere make one with  openssl rand -base64 48
UNSUBSCRIBE_SECRET=local-dev-only-unsubscribe-secret-change-me-012

# Publication metadata by DOI (FR-5.2). OPENALEX_BASE_URL defaults to https://api.openalex.org;
# tests point it at a fake server. OPENALEX_MAILTO is optional: a contact address sent with
# each request, which puts the API server in OpenAlex's faster "polite pool". Use a team
# address, not a personal one.
OPENALEX_BASE_URL=https://api.openalex.org
OPENALEX_MAILTO=

# ORCID public API, for importing a user's works (FR-5.3). Defaults to https://pub.orcid.org;
# tests point it at a fake server. No key is needed for the public API.
ORCID_BASE_URL=https://pub.orcid.org

# Send limits per user (FR-16.10): messages, and new message requests to people who are not
# connections. Counted in Redis in fixed windows. These are the defaults.
MESSAGE_LIMIT_PER_MINUTE=30
MESSAGE_LIMIT_PER_DAY=1000
MESSAGE_REQUEST_LIMIT_PER_MINUTE=5
MESSAGE_REQUEST_LIMIT_PER_DAY=20

# Message searches per user per minute (FR-16.8), counted in Redis like the send limits.
# This is the default.
MESSAGE_SEARCH_LIMIT_PER_MINUTE=30

# How long after sending a message its sender may edit it (FR-16.5), as a Go duration such as
# 15m. Deleting has no limit. This is the default.
MESSAGE_EDIT_WINDOW=15m

# clamd, the malware scanner of message attachments (FR-16.7), as host:port. docker-compose.yml
# publishes it here (CLAMAV_PORT changes the port); this is the default. Until clamd answers,
# attachments stay pending and cannot be downloaded.
CLAMAV_ADDR=127.0.0.1:3310
CLAMAV_PORT=3310
# The largest file the API sends clamd to scan, in bytes or with K, M or G. It must not be
# more than clamd's StreamMaxLength and MaxFileSize (210M in docker-compose.yml); this is the
# default.
CLAMAV_MAX_BYTES=210M
# The integration test that scans the EICAR test file with a real clamd runs only when this is
# set (make test-integration); CI sets it once clamd answers.
# TEST_CLAMAV_ADDR=127.0.0.1:3310

# Web origins that may send figures straight to MinIO (CORS), set by `make up` (minio-init in
# docker-compose.yml). This is the default.
# MINIO_CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Project figures (FR-12.2, docs/decisions.md 2026-11-18), in bytes or with K, M or G: the largest
# figure (PNG, JPG or PDF) and the most a project's figures may take. FIGURE_MAX_BYTES may be at
# most 200M in every environment, no more than PROJECT_STORAGE_MAX_BYTES and no more than
# CLAMAV_MAX_BYTES; the API refuses to start otherwise. These are the defaults.
FIGURE_MAX_BYTES=50M
PROJECT_STORAGE_MAX_BYTES=500M

# AI service (AI-1): embeddings, internal only (ai/, docs/decisions.md 2026-11-14). The API calls
# it at AI_SERVICE_URL with AI_SERVICE_TOKEN; docker-compose.yml passes the same token to the
# service and publishes it on this machine only, at AI_SERVICE_PORT. The token is at least 32
# characters; generate one with: openssl rand -base64 48. Required when APP_ENV=production; in
# development an empty token leaves the AI service off and GET /health reports it unavailable.
# The first start downloads the model (about 1.1 GB) into a Docker volume; make ai-fetch-model
# does that ahead of time.
AI_SERVICE_URL=http://127.0.0.1:8090
AI_SERVICE_TOKEN=local-dev-only-ai-service-token-change-me-0123
AI_SERVICE_PORT=8090

# Real-time editing (slice 22, docs/sync.md). The sync server (sync/, make sync) calls the API's
# internal operations at INTERNAL_API_ADDR with SYNC_SERVICE_TOKEN; both read this file. The
# internal listener must never be reachable from the internet: this machine only here, the
# private network in production (docs/deploy.md). The token is at least 32 characters and
# differs from the other secrets; generate one with: openssl rand -base64 48. Required when
# APP_ENV=production; in development an empty token turns real-time editing off (the API serves
# no internal operation and REST saves work as before).
SYNC_SERVICE_TOKEN=local-dev-only-sync-service-token-change-me-01
INTERNAL_API_ADDR=127.0.0.1:8081
# The sync server's own settings (it also reads REDIS_URL, APP_BASE_URL and LOG_LEVEL above).
# The browser connects to ws://localhost:SYNC_PORT in development and to wss://<domain>/sync
# behind the reverse proxy in production; the file is the document name, not part of the URL.
SYNC_HOST=127.0.0.1
SYNC_PORT=8091
# Members who may edit one file at once (FR-12.4, FR-12.8; 1 to 8, the cursor colours). The next
# editor opens it read-only and edits when one leaves; viewers and a user's other tabs do not count.
SYNC_MAX_EDITORS_PER_FILE=4
API_INTERNAL_URL=http://127.0.0.1:8081/api/v1

# Collaborator recommendation score (AI-2.2): score = 100 / (1 + exp(-(slope*cos + intercept))),
# fitted by make calibrate-recs on the sample tuning split for this embedding model only
# (docs/evaluation.md). These are the defaults; leave them unset unless you refit. When the
# model changes, refit: the API logs a warning while the embeddings' model differs.
RECS_SCORE_MODEL=intfloat/multilingual-e5-base@d128750597153bb5987e10b1c3493a34e5a4502a
RECS_SCORE_SLOPE=78.7208
RECS_SCORE_INTERCEPT=-70.2827

# Project recommendation score (AI-3.1, AI-2.3): the same curve for profile-project pairs, in
# both directions, fitted by make calibrate-recs for RECS_SCORE_MODEL. Profile-project cosines
# sit lower than profile-profile ones, so the people map would score good projects near 0
# (docs/evaluation.md). Refit both maps together.
RECS_PROJECT_SCORE_SLOPE=87.6849
RECS_PROJECT_SCORE_INTERCEPT=-74.5228

# Hybrid researcher search (AI-5.1, AI-5.4): how long GET /search/people waits for the AI
# service to embed the search text before it searches by keyword only and says so
# (mode keyword_fallback). A duration such as 1500ms, at most 10s.
SEARCH_AI_TIMEOUT=1500ms

# Web client (frontend/). The Next.js server forwards /api/v1 to this address, so the
# browser makes no cross-origin requests. Server-side only: never prefix it with NEXT_PUBLIC_.
API_URL=http://localhost:8080
# The API's WebSocket, which the browser reaches directly (docs/realtime.md). NEXT_PUBLIC_, so it
# goes into the browser code and is fixed at `next build`: a production build must set it to
# wss://<domain>/api/v1/ws, or it will use this development address.
NEXT_PUBLIC_WS_URL=ws://localhost:8080/api/v1/ws

# make seed-ui-compare and npm run ui:compare (dev only). The seed creates fake accounts in
# the local development database with this password; ui:compare signs in as UI_COMPARE_EMAIL.
# The seed refuses a database name ending in _test, APP_ENV=production and any remote host.
# APP_ENV is development or production. The API reads it too: production turns on the mail
# checks above and ignores TEST_EMAIL_DOMAINS (FR-17.1, FR-17.9).
APP_ENV=development
UI_COMPARE_EMAIL=compare-alpha@compare.researchsphere.local
UI_COMPARE_PASSWORD=replace-with-a-local-password

# Email trust (FR-17.2, FR-17.4, FR-17.9). Addresses at TEST_EMAIL_DOMAINS skip the sign-up
# domain checks (disposable list, MX lookup) and are never purged; production ignores the
# setting and logs a warning. example.com is where make seed-dev puts its accounts, and
# example.org is what the integration tests use: both publish a null MX, so without this they
# would be refused. sample.researchsphere.local holds the sample profiles of make sample-data.
# Accounts still unverified UNVERIFIED_ACCOUNT_DAYS after sign-up are deleted every hour (make
# purge-unverified runs it once).
TEST_EMAIL_DOMAINS=example.com,example.org,compare.researchsphere.local,sample.researchsphere.local
UNVERIFIED_ACCOUNT_DAYS=7
# make seed-dev creates or repairs test1..test4@example.com and admin@example.com with this
# password (8 to 128 characters). Development only.
DEV_SEED_PASSWORD=replace-with-a-local-password
# make sample-data gives every sample account (@sample.researchsphere.local) this one password
# (8 to 128 characters). It refuses unless APP_ENV=development, and refuses a database name
# ending in _test and any remote host. Development only, never in production.
SAMPLE_PASSWORD=replace-with-a-local-password
